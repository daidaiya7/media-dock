# Explicit release build context. Runtime data, tests and secrets are never sent.
**
!portal/
!portal/*.py
!portal/requirements.txt
!portal/static/
!portal/static/**
!scripts/
!scripts/release/
!scripts/release/requirements-build.txt
!scripts/release/build_extensions.py
!scripts/release-smoke.py
!product-mapping.json
!LICENSE
!NOTICE
!VERSION
!entrypoint.sh
portal/test_*.py
portal/static/**/*.map
portal/static/**/node_modules
portal/static/**/.DS_Store
portal/static/**/.env*
portal/static/**/*.py
portal/static/**/*.sqlite*
portal/static/**/*.db
portal/static/**/*.log
portal/static/**/*.key
portal/static/**/*.pem
